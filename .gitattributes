# ============================================================
#  行尾（EOL）策略
#
#  git 在仓库里统一按 LF 存储文本文件，签出（checkout）时再按下面的
#  eol 规则还原成本机需要的格式。没有这个文件的话，签出结果会取决于
#  各人 core.autocrlf 的设置，不可控。
# ============================================================

# 默认自动判断文本/二进制并统一为 LF
* text=auto

# ------------------------------------------------------------
#  批处理必须是 CRLF
#  cmd.exe 解析 .bat 时对 LF 换行的处理不可靠：实测遇到过
#  带标签/goto 与多行括号块的批处理在 LF 下出错。
#  这里强制签出为 CRLF，保证任何机器 clone 下来都能正常双击运行。
# ------------------------------------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf

# 源码与文档统一 LF
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# 二进制文件禁止任何行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.bin binary
