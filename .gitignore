# ============================================================
#  依赖：用 install_deps.bat 安装（约 265 MB，3869 个文件）
#  wheel 是编译产物，不该进版本库
# ============================================================
.deps/

# ============================================================
#  模型：用 download_model.bat 下载
#  large-v3 单个 2.9 GB，远超 GitHub 单文件 100 MB 的硬限制
# ============================================================
models/

# 运行时产物
.tmp/
out/
__pycache__/
*.pyc

# 本机专用：记录的是本机 Python 解释器的绝对路径，换机器即失效
.python-path.txt

# 系统垃圾文件
Thumbs.db
desktop.ini
.DS_Store
