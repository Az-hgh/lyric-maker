# ============================================================
#  依赖：start.bat 首次运行时自动安装（约 265 MB，3869 个文件）
#  wheel 是编译产物，不该进版本库
# ============================================================
.deps/

# ============================================================
#  OCR 依赖：start.bat --install-ocr 安装（可选，约 17 MB）
#  单独放一个目录是因为 pip --target 到已存在同名包的目录会先清空再装
# ============================================================
.deps-ocr/

# ============================================================
#  视频下载依赖：yt-dlp（Python API，非命令行）
#  单独放一个目录：它自带 websockets / pycryptodomex 等，
#  混进 .deps 容易和已验证过的版本打架
# ============================================================
.deps-ytdlp/

# ============================================================
#  YouTube "n 参数"挑战的 JS 求解器脚本（yt-dlp-ejs）
#  没有它 YouTube 只会给出少数低清格式
# ============================================================
.deps-ejs/

# ============================================================
#  运行时产生的数据：历史记录、浏览器 Cookie
# ============================================================
data/
cookies/

# ============================================================
#  打包：PyInstaller 本体 + 打包中间产物 + exe 成品
#  exe 里塞进了全部依赖，几百 MB，不该进版本库；
#  构建配置 lyric-maker.spec 是源码，要提交
# ============================================================
.deps-build/
dist/
build/

# 打包产物（放在项目根目录时）：
# lyric-maker.exe 和 _internal/ 是成对的，必须处于同一层目录，
# 单独挪走 exe 会启动失败
lyric-maker.exe
_internal/
# 无控制台构建下，运行时会往 exe 旁边写这个日志
lyric-maker.log

# ============================================================
#  模型：start.bat 自动下载，或用 start.bat --get-model 指定
#  large-v3 单个 2.9 GB，远超 GitHub 单文件 100 MB 的硬限制
# ============================================================
models/

# ============================================================
#  自带的外部程序：ffmpeg / node / yt-dlp.exe
#  这几个是"拷走即用"的关键（合计约 167 MB），跟着文件夹走，
#  不进版本库；换机器时用 runtime/ 里的文件即可。
# ============================================================
runtime/

# 运行时产物
.tmp/
out/
__pycache__/
*.pyc

# 界面自己记的东西：历史记录和上次用的参数，跟着 exe 走，不该进版本库
history.json
settings.json

# 本机专用：记录的是本机 Python 解释器的绝对路径，换机器即失效
.python-path.txt

# 系统垃圾文件
Thumbs.db
desktop.ini
.DS_Store
